#!/bin/sh
# CarPlayWalls 安装脚本
#
# ★ 绝对不要 killall -9 SpringBoard：
#   安装时 Sileo/Zebra 本身就跑在 SpringBoard 进程里，在这里杀掉它等于让 dpkg
#   在收尾时被中断 —— 表现就是「安装一直转圈」。所有步骤失败都不影响安装结果，
#   脚本永远 exit 0。

JB=/var/jb
IMGDIR=/var/mobile/Library/CarPlayWalls
PREFS=/var/mobile/Library/Preferences/com.minis.carplaywalls.plist
DUMP=/var/mobile/Library/Preferences/com.minis.carplaywalls.dump.plist
KILL=/var/mobile/Library/Preferences/com.minis.carplaywalls.disable

# ---- 1. 壁纸目录 ------------------------------------------------------------
mkdir -p "$IMGDIR" 2>/dev/null || true
chown mobile:mobile "$IMGDIR" 2>/dev/null || true
chmod 755 "$IMGDIR" 2>/dev/null || true

# ---- 2. 默认配置（已存在则保留用户设置）------------------------------------
if [ ! -f "$PREFS" ]; then
cat > "$PREFS" <<'PLISTEOF'
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>enabled</key>
	<true/>
	<key>mode</key>
	<integer>0</integer>
	<key>autoDerive</key>
	<true/>
	<key>generic</key>
	<false/>
	<key>diagnostics</key>
	<false/>
	<key>lightPath</key>
	<string>/var/mobile/Library/CarPlayWalls/light.jpg</string>
	<key>darkPath</key>
	<string>/var/mobile/Library/CarPlayWalls/dark.jpg</string>
</dict>
</plist>
PLISTEOF
	chown mobile:mobile "$PREFS" 2>/dev/null || true
	chmod 644 "$PREFS" 2>/dev/null || true
fi

# ---- 3. 清掉上一轮的紧急关停开关与旧诊断数据 --------------------------------
rm -f "$KILL" "$DUMP" 2>/dev/null || true
rm -rf "$JB/Library/PreferenceBundles/CarPlayWallsPrefs.bundle" 2>/dev/null || true

# ---- 故意不重启 SpringBoard（见文件头说明）---------------------------------
exit 0
